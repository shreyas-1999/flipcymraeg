rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isSuperAdmin() {
      return isAdmin() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminLevel == "super";
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Allow users to read and write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to read and write their own translation history
      match /translationHistory/{historyId} {
        allow read, write, create: if isOwner(userId);
      }
    }
    
    // Allow users to read and write their own settings
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own custom flashcards
    match /customFlashcards/{flashcardId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read public vocabulary
    match /publicVocabulary/{vocabId} {
      allow read: if isAuthenticated();
      // Only admins can write to public vocabulary
      allow write: if isAdmin();
    }
    
    // Allow users to read and write their own vocabulary progress
    match /user_vocabulary_progress/{progressId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Admin users collection - only readable by the user themselves
    match /admin_users/{userId} {
      allow read: if isOwner(userId);
      // Only super admins can write to admin_users (except initial setup)
      allow write: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        isSuperAdmin()
      );
    }
    
    // Lessons - readable by authenticated users, writable by admins
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User lesson progress - users can read/write their own progress
    match /user_lesson_progress/{progressId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Analytics data - only admins can read/write
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
    
    // System settings - only admins can read/write
    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
