rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to read and write their own translation history
      match /translationHistory/{historyId} {
        allow read, write, create: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Allow users to read and write their own custom flashcards
    match /custom_flashcards/{flashcardId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow authenticated users to read public vocabulary
    match /public_vocabulary/{vocabId} {
      allow read: if request.auth != null;
      // Only admins can write to public vocabulary
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Allow users to read and write their own vocabulary progress
    match /user_vocabulary_progress/{progressId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Admin users collection - only readable by the user themselves
    match /admin_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only super admins can write to admin_users (except initial setup)
      allow write: if request.auth != null && (
        !exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isAdmin == true &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.adminLevel == "super")
      );
    }
    
    // Allow authenticated users to read public lessons (for future use)
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}